  "components": {
    "schemas": {
      "AddCartItemRequestDto": {
        "type": "object",
        "properties": {
          "productId": {
            "maximum": 9223372036854776000,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "quantity": {
            "maximum": 100,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ConfirmTestPaymentRequestDto": {
        "type": "object",
        "properties": {
          "paymentId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "testPaymentMethod": {
            "type": "string"
          }
        }
      },
      "CreatePaymentRequestDto": {
        "type": "object",
        "properties": {
          "orderId": {
            "maximum": 9223372036854776000,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
